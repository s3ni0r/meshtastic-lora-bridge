@@ -1313,6 +1317,14 @@ GnssModel_t GPS::probe(int serialSpeed)
     }
     case 3: {
         /* Airoha (Mediatek) AG3335A/M/S, A3352Q, Quectel L89 2.0, SimCom SIM65M */
+#ifdef HIGHRATE_POSITION_SENDER
+        // Keep the module awake + out of backup sleep before probing (anti-brick; see FORK.md).
+        // NOTE: never send $PAIR382,1 — it enters a VRTC-backed backup sleep that bricks detection.
+        _serial_gps->write("$PAIR002*38\r\n"); // GNSS power ON
+        delay(200);
+        _serial_gps->write("$PAIR382,0*2F\r\n"); // ensure backup sleep is disabled
+        delay(200);
+#endif
         _serial_gps->write("$PAIR062,2,0*3C\r\n"); // GSA OFF to reduce volume
         _serial_gps->write("$PAIR062,3,0*3D\r\n"); // GSV OFF to reduce volume
         _serial_gps->write("$PAIR513*3D\r\n");     // save configuration
@@ -1570,6 +1582,25 @@ GPS *GPS::createGps()
     // Make sure the GPS is awake before performing any init.
     new_gps->up();
 
+#if defined(HIGHRATE_POSITION_SENDER) && defined(GPS_RTC_INT)
+    // GNSS hard-recovery (project fork): an earlier build sent $PAIR382,1 + $PAIR003 and left the
+    // AG3335 in a VRTC-backed backup sleep that survives reboots and ignores UART (so $PAIR021 probes
+    // get no reply). The wake is the GPS_RTC_INT line going HIGH (variant: "normal LOW, wake by HIGH").
+    // Pulse it awake, hold a longer hardware reset, then return to normal before probing.
+    pinMode(GPS_RTC_INT, OUTPUT);
+    digitalWrite(GPS_RTC_INT, HIGH); // wake from backup sleep
+    delay(300);
+#ifdef PIN_GPS_RESET
+    pinMode(PIN_GPS_RESET, OUTPUT);
+    digitalWrite(PIN_GPS_RESET, GPS_RESET_MODE);
+    delay(60);
+    digitalWrite(PIN_GPS_RESET, !GPS_RESET_MODE);
+#endif
+    delay(400);
+    digitalWrite(GPS_RTC_INT, LOW); // back to normal level
+    delay(200);
+#endif
+
 #ifdef PIN_GPS_RESET
     pinMode(PIN_GPS_RESET, OUTPUT);
     digitalWrite(PIN_GPS_RESET, GPS_RESET_MODE); // assert for 10ms
