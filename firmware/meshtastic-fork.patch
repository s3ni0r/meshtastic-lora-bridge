diff --git a/src/platform/nrf52/NRF52Bluetooth.cpp b/src/platform/nrf52/NRF52Bluetooth.cpp
index 4f7fb47..ef68d0c 100644
--- a/src/platform/nrf52/NRF52Bluetooth.cpp
+++ b/src/platform/nrf52/NRF52Bluetooth.cpp
@@ -240,13 +240,146 @@ int NRF52Bluetooth::getRssi()
 {
     return 0; // FIXME figure out where to source this
 }
+#ifdef ODID_SNIFFER
+// --- Open Drone ID (ASTM F3411 Remote ID) advertisement sniffer ----------------------------------
+// A co-located Dronetag broadcasts legacy 1M adverts: Service Data (AD 0x16), UUID 0xFFFA, app code
+// 0x0D, a 1-byte rolling counter, then a 25-byte ODID message (or a 0xF "message pack"). We decode
+// the Location message (type 0x1) — lat/lon are int32 LE deg*1e7 (same as our LoRa payload) — and the
+// 0.1s TimeStamp, logging inter-arrival dt so we can measure the TRUE position-novelty rate.
+// Latest sniffed Dronetag fix, handed off to the LoRa sender (HighRatePositionModule reads these).
+volatile int32_t g_odidLat = 0;     // deg*1e7
+volatile int32_t g_odidLon = 0;
+volatile int16_t g_odidAlt = 0;     // geo altitude, m
+volatile uint8_t g_odidSpeed = 0;   // ground speed, km/h (capped 255)
+volatile uint8_t g_odidHeading = 0; // heading, deg * 256/360
+volatile uint8_t g_odidHacc = 0;    // horizontal accuracy, m (0 = unknown / coarse > 185 m)
+volatile uint32_t g_odidMs = 0;     // millis() of the last valid decode (0 = none yet)
+
+// ODID horizontal-accuracy enum (low nibble of byte 19) -> meters upper bound (0 = unknown / coarse).
+// Per ASTM F3411 / opendroneid: 8=<92.6m, 9=<30m, 10=<10m, 11=<3m, 12=<1m; 0-7 + 13-15 coarse/unknown.
+static const uint8_t odidHaccMeters[16] = {0, 0, 0, 0, 0, 0, 0, 0, 93, 30, 10, 3, 1, 0, 0, 0};
+
+static uint32_t odidLastMs = 0;
+// Benchmark instrumentation: scan-callback load + extended/Location split, logged every 5 s.
+static uint32_t sCb = 0, sExt = 0, sLoc = 0, sStatsMs = 0;
+
+static void odidDecodeLocation(const uint8_t *m, uint8_t counter, int8_t rssi)
+{
+    sLoc++;
+    int32_t lat = (int32_t)((uint32_t)m[5] | (uint32_t)m[6] << 8 | (uint32_t)m[7] << 16 | (uint32_t)m[8] << 24);
+    int32_t lon = (int32_t)((uint32_t)m[9] | (uint32_t)m[10] << 8 | (uint32_t)m[11] << 16 | (uint32_t)m[12] << 24);
+    // Vector fields. byte1 = [SpeedMult:1][EWDir:1][HeightType:1][Rsvd:1][Status:4].
+    bool speedMult = m[1] & 0x01;
+    bool ewDir = (m[1] >> 1) & 0x01;
+    int hdgDeg = (m[2] <= 179) ? (m[2] + (ewDir ? 180 : 0)) : 0;                         // 0..359
+    float spdMps = (m[3] == 0xFF) ? 0.0f : (speedMult ? (m[3] * 0.75f + 63.75f) : (m[3] * 0.25f));
+    int spdKmh = (int)(spdMps * 3.6f + 0.5f);
+    int16_t altM = (int16_t)((int)((uint16_t)(m[15] | (m[16] << 8))) / 2 - 1000);        // 0.5 m/LSB, -1000
+    uint8_t hAcc = odidHaccMeters[m[19] & 0x0F];
+    uint16_t ts = (uint16_t)(m[21] | (m[22] << 8)); // ODID fix timestamp, tenths of sec since top-of-hour
+
+    uint32_t now = millis();
+    if (lat != 0 || lon != 0) { // valid fix -> hand off to the LoRa sender
+        g_odidLat = lat;
+        g_odidLon = lon;
+        g_odidAlt = altM;
+        g_odidSpeed = (uint8_t)(spdKmh > 255 ? 255 : spdKmh);
+        g_odidHeading = (uint8_t)((hdgDeg * 256) / 360);
+        g_odidHacc = hAcc;
+        g_odidMs = now;
+    }
+    uint32_t dt = odidLastMs ? (now - odidLastMs) : 0;
+    odidLastMs = now;
+    LOG_INFO("ODID LOC cnt=%u dt=%lums ts=%u lat=%d lon=%d alt=%dm spd=%dkmh hdg=%d hacc=%um rssi=%d",
+             counter, (unsigned long)dt, ts, lat, lon, altM, spdKmh, hdgDeg, hAcc, rssi);
+}
+
+static void odidScanCb(ble_gap_evt_adv_report_t *report)
+{
+    sCb++;
+    if (report->type.extended_pdu)
+        sExt++;
+    uint32_t nowS = millis();
+    if (sStatsMs == 0)
+        sStatsMs = nowS;
+    if (nowS - sStatsMs >= 5000) {
+        LOG_INFO("SNIFF cb=%u ext=%u loc=%u in %lums", sCb, sExt, sLoc, (unsigned long)(nowS - sStatsMs));
+        sCb = sExt = sLoc = 0;
+        sStatsMs = nowS;
+    }
+#if defined(ODID_PHY_EXT)
+    // BT5 mode: decode ONLY extended packs — skip every legacy PDU (the Dronetag's own 4-5 legacy
+    // adverts AND nearby BLE4 noise) so the data is one clean pack per cycle.
+    if (!report->type.extended_pdu) {
+        Bluefruit.Scanner.resume();
+        return;
+    }
+#endif
+    uint8_t buf[255]; // a BT5 extended ODID message pack can be ~250 B; BT4 legacy uses <= 31
+    uint8_t len = Bluefruit.Scanner.parseReportByType(report, BLE_GAP_AD_TYPE_SERVICE_DATA, buf, sizeof(buf));
+    // Expect: [0xFA][0xFF] (UUID 0xFFFA) [0x0D] (app) [counter] [ODID message(s)]
+    if (len >= 5 && buf[0] == 0xFA && buf[1] == 0xFF && buf[2] == 0x0D) {
+        uint8_t counter = buf[3];
+        const uint8_t *odid = &buf[4];
+        uint8_t odidLen = len - 4;
+        uint8_t type = (odid[0] >> 4) & 0x0F;
+        if (type == 0x1 && odidLen >= 23) { // single Location message (BT4 legacy)
+            odidDecodeLocation(odid, counter, report->rssi);
+        } else if (type == 0xF && odidLen >= 3 && odid[1] == 25) { // BT5 message pack of 25-byte msgs
+            uint8_t qty = odid[2];
+            if (qty > 9) // ODID_PACK_MAX_MESSAGES
+                qty = 9;
+            for (uint8_t i = 0; i < qty; i++) {
+                const uint8_t *m = odid + 3 + i * 25;
+                if ((uint32_t)((m + 25) - odid) > odidLen) // require a full 25-byte message in-bounds
+                    break;
+                if (((m[0] >> 4) & 0x0F) == 0x1) {
+                    odidDecodeLocation(m, counter, report->rssi);
+                    break;
+                }
+            }
+        }
+    }
+    Bluefruit.Scanner.resume(); // MANDATORY: S140 auto-pauses scanning after each delivered report
+}
+
+static void startOdidScanner(void)
+{
+    Bluefruit.Scanner.setRxCallback(odidScanCb);
+    Bluefruit.Scanner.useActiveScan(false);     // ODID is in the primary/extended advert, not scan-rsp
+    Bluefruit.Scanner.setInterval(160, 160);    // CONTINUOUS scan (window==interval) — catch every advert
+    Bluefruit.Scanner.restartOnDisconnect(true);
+    // PHY/extended selection on the live scan-params pointer (Bluefruit exposes no setter for these).
+    ble_gap_scan_params_t *sp = Bluefruit.Scanner.getParams();
+#if defined(ODID_PHY_EXT)
+    // BT5: accept EXTENDED advertising on the 1M secondary channel — the Dronetag's BT5 path packs all
+    // ODID messages into one PDU. REQUIRES the 255-byte scan buffer (firmware/patch-bluefruit-ext.sh).
+    sp->extended = 1;
+    // Dronetag "BT5 Long Range" = CODED PHY (not 1M extended). Scanning Coded also rejects ALL 1M
+    // legacy outright (the Dronetag's own + nearby BLE4 noise) — only the Coded message-pack is seen.
+    sp->scan_phys = BLE_GAP_PHY_CODED;
+    sp->report_incomplete_evts = 0;
+    LOG_INFO("ODID sniffer: BT5 EXTENDED scan on CODED PHY / Long Range (255B buffer)");
+#else
+    sp->extended = 0;                           // BT4 legacy 1M (default; best Location refresh)
+    sp->scan_phys = BLE_GAP_PHY_AUTO;
+    LOG_INFO("ODID sniffer: BT4 legacy continuous scan (scan-only, GPS off)");
+#endif
+    Bluefruit.Scanner.start(0);                 // 0 = scan forever
+}
+#endif // ODID_SNIFFER
+
 void NRF52Bluetooth::setup()
 {
     // Initialise the Bluefruit module
     LOG_INFO("Init the Bluefruit nRF52 module");
     Bluefruit.autoConnLed(false);
     Bluefruit.configPrphBandwidth(BANDWIDTH_MAX);
+#ifdef ODID_SNIFFER
+    Bluefruit.begin(1, 1); // 1 peripheral (phone) + 1 observer (Remote ID sniffer)
+#else
     Bluefruit.begin();
+#endif
     // Clear existing data.
     Bluefruit.Advertising.stop();
     Bluefruit.Advertising.clearData();
@@ -292,10 +425,19 @@ void NRF52Bluetooth::setup()
     // BLEService and BLECharacteristic classes
     LOG_INFO("Init the Mesh bluetooth service");
     setupMeshService();
+#ifdef ODID_SNIFFER
+    // Scan-only bridge: do NOT advertise. With no advertising and no phone connection the SoftDevice
+    // gives the BLE observer ~100% radio time. Configure the Tag over USB. (Keeping begin(1,1) and just
+    // skipping startAdv is safer than begin(0,1), which skips per-peripheral CONN_CFG setup.)
+    Bluefruit.Advertising.stop();
+    LOG_INFO("ODID_SNIFFER: scan-only, advertising disabled");
+    startOdidScanner();
+#else
     // Setup the advertising packet(s)
     LOG_INFO("Set up the advertising payload(s)");
     startAdv();
     LOG_INFO("Advertise");
+#endif
 }
 void NRF52Bluetooth::resumeAdvertising()
 {
